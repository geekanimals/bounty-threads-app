{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/superadmin/",
      "destination": "/superadmin",
      "permanent": false
    },
    {
      "source": "/agency/",
      "destination": "/agency",
      "permanent": false
    },
    {
      "source": "/brand/",
      "destination": "/brand",
      "permanent": false
    },
    {
      "source": "/refund.html",
      "destination": "/terms.html#refund",
      "permanent": false
    },
    {
      "source": "/shipping.html",
      "destination": "/terms.html#shipping",
      "permanent": false
    },
    {
      "source": "/contact.html",
      "destination": "/terms.html#contact",
      "permanent": false
    },
    {
      "source": "/refund",
      "destination": "/terms.html#refund",
      "permanent": false
    },
    {
      "source": "/shipping",
      "destination": "/terms.html#shipping",
      "permanent": false
    },
    {
      "source": "/contact",
      "destination": "/terms.html#contact",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/superadmin",
      "destination": "/app.html"
    },
    {
      "source": "/brand",
      "destination": "/app.html"
    },
    {
      "source": "/agency",
      "destination": "/app.html"
    },
    {
      "source": "/kit/:username",
      "destination": "/p.html"
    },
    {
      "source": "/go/:slug",
      "destination": "/go.html"
    }
  ]
}
